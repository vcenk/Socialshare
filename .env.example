# Firebase Configuration (for extension/background/service-worker.ts)
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_FUNCTIONS_URL=https://us-central1-your-project-id.cloudfunctions.net

# For Firebase Cloud Functions (set via firebase functions:config:set)
# firebase functions:config:set openai.key="sk-your-openai-key"
# firebase functions:config:set stripe.secret_key="sk_your_stripe_key"
# firebase functions:config:set stripe.webhook_secret="whsec_your_webhook_secret"

# Or use .runtimeconfig.json for local development:
# {
#   "openai": { "key": "sk-..." },
#   "stripe": { "secret_key": "sk_...", "webhook_secret": "whsec_..." }
# }
