{
  "name": "socialforge-functions",
  "version": "1.0.0",
  "description": "SocialForge Cloud Functions",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "openai": "^4.20.0",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^18.18.0"
  },
  "private": true
}
